# TrueForge Local Harness Configuration
# FORGE//SENTINEL connects to local TrueForge instance.
# Configure GEMINI_API_KEY in FORGE-SENTINEL/.env (ignored by Git) or export it in your shell
# so FORGE//SENTINEL and TrueForge can auto-provision the Google Gemini provider.

TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_API_KEY=trueforge-standalone

# Google Gemini Developer API Key (Required for Gemini 3.8 Flash inference via TrueForge)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default workspace root override (defaults to current active VS Code workspace folder)
# FORGE_WORKSPACE_ROOT=


